# TruthLens Environment Variables
# Hackathon Track 1: AI and Trustworthy Electoral Information

# LLM Provider Configuration (gemini, openai, anthropic)
# If empty or invalid, TruthLens automatically falls back to high-fidelity DEMO_MODE
LLM_PROVIDER=gemini
LLM_API_KEY=your_api_key_here

# DEMO_MODE: Force offline precomputed responses for synthetic demo claims
# (Automatically enabled if LLM call fails, times out after 15s, or API key is omitted)
DEMO_MODE=false
